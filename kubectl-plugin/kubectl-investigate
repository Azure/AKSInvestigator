#!/usr/bin/env bash
# Adapted from https://github.com/mainred/investigate.
# kubectl plugin that asks the in-cluster AKS Investigator to investigate a question.

set -euo pipefail

NAMESPACE="${INVESTIGATOR_NAMESPACE:-aks-investigator}"
SELECTOR="${INVESTIGATOR_SELECTOR:-app=holmes}"
RELEASE="${INVESTIGATOR_RELEASE:-aks-investigator}"
DEPLOY="${INVESTIGATOR_DEPLOY:-}"
HOME_DIR="${INVESTIGATOR_HOME:-/tmp}"

usage() {
  cat >&2 <<EOF
kubectl-investigate: ask AKS Investigator to investigate a cluster question.

Usage:
  kubectl investigate "<question>" [holmes_cli flags...]

Examples:
  kubectl investigate "how many pods are in my cluster"
  kubectl investigate "why is pod X crashlooping" --model saturn-vllm

Environment:
  INVESTIGATOR_NAMESPACE  namespace containing AKS Investigator (default: aks-investigator)
  INVESTIGATOR_RELEASE    Helm release to target (default: aks-investigator)
  INVESTIGATOR_DEPLOY     deployment name; overrides release and discovery
  INVESTIGATOR_SELECTOR   fallback deployment selector (default: app=holmes)
  INVESTIGATOR_HOME       HOME inside the pod (default: /tmp)
EOF
}

if [[ $# -eq 0 ]]; then
  usage
  exit 64
fi

# Disable shell tracing before expanding credentials. Remote env assignments
# are still visible in process arguments and potentially Kubernetes audit logs.
set +x
# --trace belongs to Holmes; only validate credentials for internal runs.
braintrust=false
previous_argument=""
for argument in "$@"; do
  [[ "$argument" == "--" ]] && break
  if [[ ( "$previous_argument" == "--trace" && "$argument" == "braintrust" ) ||
        "$argument" == "--trace=braintrust" ]]; then
    braintrust=true
    break
  fi
  previous_argument="$argument"
done
if $braintrust && [[ -z "${BRAINTRUST_API_KEY:-}" || -z "${BRAINTRUST_ORG:-}" ]]; then
  echo "kubectl-investigate: --trace braintrust requires local BRAINTRUST_API_KEY and BRAINTRUST_ORG." >&2
  exit 64
fi

if ! command -v kubectl >/dev/null 2>&1; then
  echo "kubectl-investigate: kubectl was not found on PATH." >&2
  exit 127
fi

if [[ -z "$DEPLOY" ]]; then
  release_deploy="${RELEASE}-holmes"
  if kubectl get deployment -n "$NAMESPACE" "$release_deploy" >/dev/null 2>&1; then
    DEPLOY="$release_deploy"
  else
    deployments=()
    while IFS= read -r deployment; do
      [[ -n "$deployment" ]] && deployments+=("${deployment#deployment.apps/}")
    done < <(kubectl get deployments -n "$NAMESPACE" -l "$SELECTOR" -o name 2>/dev/null || true)

    case "${#deployments[@]}" in
      0)
        echo "kubectl-investigate: no Holmes deployment found in namespace '$NAMESPACE'." >&2
        echo "  Looked for '$release_deploy', then selector '$SELECTOR'." >&2
        echo "  Set INVESTIGATOR_NAMESPACE, INVESTIGATOR_RELEASE, INVESTIGATOR_DEPLOY, or INVESTIGATOR_SELECTOR to override." >&2
        exit 1
        ;;
      1)
        DEPLOY="${deployments[0]}"
        ;;
      *)
        echo "kubectl-investigate: multiple Holmes deployments match '$SELECTOR' in namespace '$NAMESPACE':" >&2
        printf '  %s\n' "${deployments[@]}" >&2
        echo "  Set INVESTIGATOR_RELEASE or INVESTIGATOR_DEPLOY to choose one." >&2
        exit 1
        ;;
    esac
  fi
fi

exec_flags=()
if [[ -t 0 && -t 1 ]]; then
  exec_flags=(-it)
fi

default_mode=(--no-interactive)
for argument in "$@"; do
  case "$argument" in
    -i|--interactive|-n|--no-interactive)
      default_mode=()
      break
      ;;
  esac
done

remote_command=(env "HOME=$HOME_DIR")
if $braintrust; then
  # Each assignment is one literal argument; never evaluate values as code.
  remote_command+=("BRAINTRUST_API_KEY=$BRAINTRUST_API_KEY"
                   "BRAINTRUST_ORG=$BRAINTRUST_ORG")
fi
remote_command+=(python holmes_cli.py ask "$@" "${default_mode[@]}")

remote_timing=""
if [[ "${INVESTIGATOR_TIMING:-0}" == 1 ]]; then
  # Read by the optional performance collector using the client's monotonic clock.
  printf '__AKSI_TIMING_EXEC_REQUEST__\n' >&2
  remote_timing='printf "__AKSI_TIMING_EXEC_STARTED__\n" >&2; '
fi

if [[ "${INVESTIGATOR_TIMING:-0}" == 1 ]]; then
  exec kubectl exec "${exec_flags[@]}" -n "$NAMESPACE" "deploy/$DEPLOY" -- \
    bash -c "$remote_timing"'exec "$@"' investigate-timing \
    "${remote_command[@]}"
fi

exec kubectl exec "${exec_flags[@]}" -n "$NAMESPACE" "deploy/$DEPLOY" -- \
  "${remote_command[@]}"
